---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <section class="wrap">
    <p class="eyebrow">Erro 404</p>
    <h1 class="serif">Esta página não existe.</h1>
    <p>O endereço pode ter mudado. Os projetos estão todos na página inicial.</p>
    <a class="btn primary" href="/#projetos">Ver projetos</a>
  </section>
</Base>

<style>
  section {
    padding-block: clamp(64px, 12vw, 140px);
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1.05;
    margin: 14px 0 12px;
  }
  p:not(.eyebrow) {
    color: var(--muted);
    margin: 0 0 28px;
  }
</style>
