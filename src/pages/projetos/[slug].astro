---
import { Image, getImage } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Selos from '../../components/Selos.astro';

export async function getStaticPaths() {
  const projetos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
  return projetos.map((projeto, i) => ({
    params: { slug: projeto.id },
    props: { projeto, proximo: projetos[(i + 1) % projetos.length] },
  }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
  proximo: CollectionEntry<'projetos'>;
}

const { projeto, proximo } = Astro.props;
const { data } = projeto;
const { Content } = await render(projeto);
const og = data.capa ? (await getImage({ src: data.capa, width: 1200, format: 'jpeg' })).src : undefined;
---

<Base title={data.titulo} description={data.resumo} image={og}>
  <article>
    <header class="wrap cabeca">
      <a class="voltar" href="/#projetos">← Todos os projetos</a>
      <p class="eyebrow">{data.tipo} · {data.periodo}</p>
      <h1 class="serif">{data.titulo}</h1>
      <p class="lead">{data.resumo}</p>
      <div class="selos"><Selos data={data} /></div>
      {
        (data.links.demo || data.links.codigo || data.links.download) && (
          <div class="acoes">
            {data.links.demo && (
              <a class="btn primary" href={data.links.demo} target="_blank" rel="noopener">
                Abrir a demonstração ↗
              </a>
            )}
            {data.links.download && (
              <a class="btn primary" href={data.links.download} target="_blank" rel="noopener">
                Baixar ↗
              </a>
            )}
            {data.links.codigo && (
              <a class="btn" href={data.links.codigo} target="_blank" rel="noopener">
                Código no GitHub ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      data.capa && (
        <figure class:list={['wrap', 'capa', data.capaRetrato && 'retrato']}>
          <Image
            src={data.capa}
            alt={data.capaAlt ?? ''}
            widths={data.capaRetrato ? [360, 720] : [720, 1120, 1600]}
            sizes={data.capaRetrato ? '360px' : '(min-width: 1180px) 1120px, 100vw'}
            loading="eager"
          />
        </figure>
      )
    }

    <div class="wrap corpo">
      <aside class="ficha" aria-label="Ficha do projeto">
        {
          data.numeros.length > 0 && (
            <dl class="numeros">
              {data.numeros.map((n) => (
                <div>
                  <dt>{n.rotulo}</dt>
                  <dd class="serif">{n.valor}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div>
          <p class="eyebrow">Tecnologias</p>
          <ul class="tags">{data.stack.map((t) => <li>{t}</li>)}</ul>
        </div>
        {
          data.codigo === 'privado' && (
            <p class="privado">
              O código deste projeto é privado. Se você quer avaliá-lo, posso liberar o acesso ao
              repositório: <a href="/#contato">fale comigo</a>.
            </p>
          )
        }
      </aside>

      <div class="texto">
        <Content />
      </div>
    </div>

    {
      data.galeria.length > 0 && (
        <section class="wrap galeria" aria-label="Capturas de tela">
          {data.galeria.map((g) => (
            <figure>
              <Image src={g.src} alt={g.alt} widths={[720, 1120, 1600]} sizes="(min-width: 1180px) 1120px, 100vw" />
              {g.legenda && <figcaption>{g.legenda}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {
      proximo.id !== projeto.id && (
        <nav class="wrap proximo" aria-label="Próximo projeto">
          <a href={`/projetos/${proximo.id}/`}>
            <span class="eyebrow">Próximo projeto</span>
            <span class="serif nome">{proximo.data.titulo} →</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .cabeca {
    padding-top: clamp(32px, 6vw, 64px);
  }

  .voltar {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .voltar:hover {
    color: var(--text);
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 12px 0 0;
  }

  .lead {
    max-width: 60ch;
    margin: 20px 0 0;
    font-size: 1.18rem;
    color: var(--muted);
  }

  .selos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .capa {
    margin-top: clamp(32px, 5vw, 56px);
  }

  .capa :global(img),
  .galeria :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .capa.retrato {
    display: grid;
    place-items: center;
    padding-block: 40px;
    background: radial-gradient(circle at 50% 30%, #2a2350, #0b0c12 70%);
    border-radius: var(--radius);
    max-width: calc(var(--wrap));
    width: calc(100% - 2 * var(--gutter));
  }

  .capa.retrato :global(img) {
    width: min(360px, 100%);
    border: 0;
  }

  .corpo {
    display: grid;
    gap: 36px;
    margin-top: clamp(36px, 6vw, 64px);
  }

  @media (min-width: 900px) {
    .corpo {
      grid-template-columns: 300px 1fr;
      gap: 64px;
      align-items: start;
    }

    .ficha {
      position: sticky;
      top: 88px;
    }
  }

  .ficha {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ficha .eyebrow {
    margin-bottom: 10px;
  }

  .numeros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
    margin: 0;
  }

  .numeros dt {
    font-size: 0.82rem;
    color: var(--faint);
    line-height: 1.3;
  }

  .numeros dd {
    margin: 2px 0 0;
    font-size: 2rem;
    line-height: 1.1;
  }

  .privado {
    margin: 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .texto {
    max-width: 68ch;
    min-width: 0;
  }

  .texto :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.15;
    margin: 44px 0 12px;
  }

  .texto :global(h2:first-child) {
    margin-top: 0;
  }

  .texto :global(p),
  .texto :global(li) {
    color: color-mix(in srgb, var(--text) 86%, var(--muted));
  }

  .texto :global(ul) {
    padding-left: 1.2em;
  }

  .texto :global(li) {
    margin-bottom: 8px;
  }

  .texto :global(li::marker) {
    color: var(--accent);
  }

  .texto :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .texto :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
  }

  .texto :global(a) {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }

  .galeria {
    display: grid;
    gap: 40px;
    margin-top: clamp(48px, 8vw, 88px);
  }

  .galeria figure {
    margin: 0;
  }

  figcaption {
    margin-top: 12px;
    font-size: 0.9rem;
    color: var(--faint);
  }

  .proximo {
    margin-top: clamp(56px, 9vw, 104px);
  }

  .proximo a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .proximo .nome {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    transition: color 0.15s;
  }

  .proximo a:hover .nome {
    color: var(--accent);
  }
</style>
