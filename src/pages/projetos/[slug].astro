---
// Cada projeto tem endereço próprio: a página é a mesma área de trabalho, com a janela dele aberta.
import { getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Desktop from '../../components/os/Desktop.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const { data } = projeto;
const og = data.capa ? (await getImage({ src: data.capa, width: 1200, format: 'jpeg' })).src : undefined;
const janela = `projeto-${projeto.id}`;
---

<Base title={data.titulo} description={data.resumo} image={og}>
  <Desktop inicial={[janela]} inicialMovel={[janela]} />
</Base>
