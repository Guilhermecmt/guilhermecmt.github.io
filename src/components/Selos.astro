---
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'projetos'>['data'];
}

const { data } = Astro.props;
---

<span class:list={['badge', (data.situacao === 'No ar' || data.situacao === 'Disponível') && 'ok']}>{data.situacao}</span>
{
  data.codigo === 'aberto' ? (
    <span class="badge accent">Código aberto</span>
  ) : (
    <span class="badge" title="O código-fonte não é público. Acesso para avaliação sob pedido.">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="11" width="14" height="10" rx="2" />
        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
      </svg>
      Código privado
    </span>
  )
}
