---
// "Sobre este Mac", só que sobre o Guilherme.
import { site } from '../../site.config';

const ferramentas = [
  'TypeScript', 'Python', 'Node.js', 'React', 'Next.js', 'NestJS', 'FastAPI', 'PostgreSQL',
  'Prisma', 'Redis', 'SQLite', 'DuckDB', 'Docker', 'Electron', 'Capacitor', 'Ollama',
];
---

<div class="rolagem sobre">
  <div class="foto-agente" data-foto-agente title="Clique três vezes">
    <img class="avatar foto" src="/perfil.webp" alt={`Foto de ${site.nome}`} width="320" height="320" decoding="async" />
    <svg class="oculos-meme" viewBox="0 0 30 8" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M0 0h30v2H0Z M1 2h11v3H1Z M2 5h9v1H2Z M3 6h7v1H3Z M18 2h11v3H18Z M19 5h9v1h-9Z M20 6h7v1h-7Z M12 2h6v1h-6Z" fill="#000"></path>
      <path d="M3 2h2v1H3Z M5 3h2v1H5Z M20 2h2v1h-2Z M22 3h2v1h-2Z" fill="#fff"></path>
    </svg>
  </div>
  <h2 data-nome>{site.nome}</h2>
  <p class="papel-txt">{site.papel} · {site.local}</p>
  <p class="slogan">{site.slogan}</p>

  <dl class="ficha-mac">
    <dt>Tecnologias</dt>
    <dd>TypeScript · Python · APIs · IA</dd>
    <dt>Interesses</dt>
    <dd>Software · Automação · Produtos</dd>
  </dl>

  <div class="texto">
    <p>Gosto de transformar problemas em software.</p>
    <p>
      Trabalho da arquitetura e dos dados à interface, automação e infraestrutura — construindo
      produtos que realmente possam ser usados, não apenas protótipos.
    </p>
    <ul class="etiquetas" aria-label="Ferramentas que uso">
      {ferramentas.map((f) => <li>{f}</li>)}
    </ul>
  </div>

  <div class="acoes">
    <a class="xp-btn primario" href="/#projetos" data-cmd="abrir:projetos">Ver projetos</a>
    <a class="xp-btn" href={`mailto:${site.email}`} data-cmd="abrir:contato">Falar comigo</a>
  </div>
  <p class="rodape-mac">GuiOs 26x.04p</p>
</div>
