    <path d="M5 13c0-5 3-8 8-8h22c5 0 8 3 8 8v3c-9 4-29 4-38 0Z" fill="url(#g-brilho)" opacity=".35"></path>
    <path d="M18 17l-7 7 7 7M30 17l7 7-7 7M26.5 14l-5 20" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  </symbol>

  <symbol id="i-linkedin" viewBox="0 0 48 48">
    <rect x="3" y="3" width="42" height="42" rx="10" fill="url(#g-azul)" stroke="#123f9c"></rect>
    <path d="M5 13c0-5 3-8 8-8h22c5 0 8 3 8 8v3c-9 4-29 4-38 0Z" fill="url(#g-brilho)" opacity=".45"></path>
    <text x="24" y="33" text-anchor="middle" font-family="Tahoma, Verdana, sans-serif" font-size="20" font-weight="700" fill="#fff">in</text>
  </symbol>

  <symbol id="i-enviar" viewBox="0 0 48 48">
    <use href="#i-correio"></use>
    <path d="M30 6h12v12" fill="none" stroke="#2f9a2c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M41 7L29 19" stroke="#2f9a2c" stroke-width="4" stroke-linecap="round"></path>
  </symbol>

  <symbol id="i-copiar" viewBox="0 0 48 48">
    <rect x="6" y="6" width="24" height="28" rx="2" fill="url(#g-papel)" stroke="#7f93b2"></rect>
    <rect x="17" y="14" width="24" height="28" rx="2" fill="url(#g-papel)" stroke="#5f7396"></rect>
    <path d="M22 22h14M22 27h14M22 32h9" stroke="#9fb3d6" stroke-width="1.8"></path>
  </symbol>

  <symbol id="i-globo" viewBox="0 0 48 48">
    <circle cx="24" cy="24" r="19" fill="url(#g-azul)" stroke="#123f9c" stroke-width="1.5"></circle>
    <path d="M14 14c4 2 6 6 4 10s-6 4-7 8M30 9c-2 4 1 6 4 7s5 5 3 9-6 3-7 8" fill="none" stroke="#7ee07a" stroke-width="4" stroke-linecap="round"></path>
    <ellipse cx="22" cy="15" rx="12" ry="6" fill="url(#g-brilho)" opacity=".55"></ellipse>
