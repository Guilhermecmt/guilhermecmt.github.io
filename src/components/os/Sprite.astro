    <path d="M12 16h24M12 24h24M12 32h24" stroke="#9fb3d6" stroke-width="3" stroke-linecap="round"></path>
    <circle cx="19" cy="16" r="4" fill="url(#g-azul)" stroke="#123f9c"></circle>
    <circle cx="30" cy="24" r="4" fill="url(#g-verde)" stroke="#145214"></circle>
    <circle cx="16" cy="32" r="4" fill="url(#g-amarelo)" stroke="#9a6b00"></circle>
  </symbol>

  <symbol id="i-mc" viewBox="0 0 48 48">
    <rect x="3" y="5" width="42" height="38" rx="6" fill="url(#g-escuro)" stroke="#000"></rect>
    <rect x="8" y="10" width="15" height="11" rx="2" fill="url(#g-azul)"></rect>
    <rect x="25.5" y="10" width="15" height="11" rx="2" fill="url(#g-verde)"></rect>
