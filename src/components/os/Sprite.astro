---
// Todos os ícones do sistema num sprite só, usado com <use href="#i-...">. Fica fora da tela, mas não
// com display:none, porque os gradientes de um SVG escondido assim deixam de funcionar em alguns navegadores.
import { iconeDe } from '../../lib/icones';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
---

<svg class="sprite" width="0" height="0" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    <linearGradient id="g-brilho" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".75"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="g-pasta" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffeaa6"></stop>
      <stop offset=".45" stop-color="#f7cb52"></stop>
      <stop offset="1" stop-color="#e2a526"></stop>
    </linearGradient>
    <linearGradient id="g-pasta-tras" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3c548"></stop>
      <stop offset="1" stop-color="#c88d17"></stop>
    </linearGradient>
    <linearGradient id="g-papel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff"></stop>
      <stop offset="1" stop-color="#e2e9f4"></stop>
    </linearGradient>
    <linearGradient id="g-azul" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#78b8ff"></stop>
      <stop offset=".5" stop-color="#2f7bf0"></stop>
      <stop offset="1" stop-color="#1550c8"></stop>
    </linearGradient>
    <linearGradient id="g-verde" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9be58a"></stop>
      <stop offset=".5" stop-color="#43a83c"></stop>
      <stop offset="1" stop-color="#22791f"></stop>
    </linearGradient>
    <linearGradient id="g-vermelho" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff9c86"></stop>
      <stop offset=".5" stop-color="#e2452d"></stop>
      <stop offset="1" stop-color="#b52312"></stop>
    </linearGradient>
    <linearGradient id="g-amarelo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe98a"></stop>
      <stop offset=".5" stop-color="#f6c22c"></stop>
      <stop offset="1" stop-color="#d79a0a"></stop>
    </linearGradient>
    <linearGradient id="g-escuro" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a4a4f"></stop>
      <stop offset="1" stop-color="#0d0d10"></stop>
    </linearGradient>
    <linearGradient id="g-metal" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#9fb2cc"></stop>
      <stop offset=".35" stop-color="#eef3fa"></stop>
      <stop offset="1" stop-color="#8195b3"></stop>
    </linearGradient>
    <linearGradient id="g-avatar" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5fb0ff"></stop>
      <stop offset=".55" stop-color="#1f62e0"></stop>
      <stop offset="1" stop-color="#1238a8"></stop>
    </linearGradient>
    <linearGradient id="g-logo-1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff7ac0"></stop>
      <stop offset="1" stop-color="#d01f74"></stop>
    </linearGradient>
    <linearGradient id="g-logo-2" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6fe2ff"></stop>
      <stop offset="1" stop-color="#1390c8"></stop>
    </linearGradient>
    <linearGradient id="g-logo-3" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ad94ff"></stop>
      <stop offset="1" stop-color="#5732d4"></stop>
    </linearGradient>
    <linearGradient id="g-logo-4" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd76a"></stop>
      <stop offset="1" stop-color="#ef8410"></stop>
    </linearGradient>
    <filter id="f-sombra" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation=".7" flood-color="#000" flood-opacity=".35"></feDropShadow>
    </filter>
    {
      slugs.map((slug) => {
        const [a, b] = iconeDe(slug).cores;
        return (
          <linearGradient id={`g-p-${slug}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color={a} />
            <stop offset="1" stop-color={b} />
          </linearGradient>
        );
      })
    }
  </defs>

  <!-- Logo do GuiOs 26x.04p: uma bandeira ondulada de quatro panos -->
  <symbol id="i-logo" viewBox="0 0 48 48">
    <g stroke="#000" stroke-opacity=".28" stroke-width=".8" stroke-linejoin="round">
      <path d="M5.2 9C10.5 6.4 15.5 6.4 22.2 8.6L20.6 22.4C14.2 20.4 9.2 20.4 3.6 22.6Z" fill="url(#g-logo-1)"></path>
      <path d="M24.6 9.3C31 11.3 37.2 11.6 44.2 8.6L42.6 22.4C36.2 25.1 29.6 24.9 23 23.1Z" fill="url(#g-logo-2)"></path>
      <path d="M3.3 25.3C9 23.2 14.1 23.2 20.3 25.2L18.8 39C12.6 37 7.6 37 1.8 39.1Z" fill="url(#g-logo-3)"></path>
      <path d="M22.7 25.9C29.3 27.7 35.8 27.9 42.3 25.2L40.8 39C34.5 41.8 28 41.6 21.2 39.7Z" fill="url(#g-logo-4)"></path>
    </g>
    <g fill="#fff" opacity=".38">
      <path d="M5.6 10.2C10.6 8 15.4 8 21.6 9.9L21.1 14.5C15 12.8 10.4 12.8 5 14.8Z"></path>
      <path d="M25 10.6C31 12.4 37 12.7 43.4 10L42.9 14.6C36.6 17.2 30.6 17 24.5 15.2Z"></path>
      <path d="M3.6 26.5C9.1 24.6 14 24.6 19.8 26.4L19.3 30.8C13.6 29.1 8.8 29.1 3.1 31Z"></path>
      <path d="M23 27.1C29.2 28.8 35.4 29 41.5 26.5L41 30.9C34.9 33.5 28.8 33.3 22.5 31.6Z"></path>
    </g>
  </symbol>

  <symbol id="i-avatar" viewBox="0 0 48 48">
    <rect x="1" y="1" width="46" height="46" rx="11" fill="url(#g-avatar)"></rect>
    <path d="M3 12c0-6 3-9 9-9h24c6 0 9 3 9 9v4c-9 4-33 4-42 0Z" fill="url(#g-brilho)" opacity=".7"></path>
    <text x="24" y="31.5" text-anchor="middle" font-family="Trebuchet MS, Segoe UI, sans-serif" font-size="19" font-weight="700" fill="#fff" filter="url(#f-sombra)">GM</text>
  </symbol>

  <symbol id="i-pasta" viewBox="0 0 48 48">
    <path d="M4 11.5A2.5 2.5 0 0 1 6.5 9h11l4 4h19A2.5 2.5 0 0 1 43 15.5V38a2.5 2.5 0 0 1-2.5 2.5h-34A2.5 2.5 0 0 1 4 38Z" fill="url(#g-pasta-tras)" stroke="#a87412"></path>
    <rect x="9" y="12.5" width="29" height="15" rx="1" fill="#fff" stroke="#c9c9c9"></rect>
    <path d="M13 16.5h18M13 20h14" stroke="#9fb3d6" stroke-width="1.4"></path>
    <path d="M6.3 19.5A2.5 2.5 0 0 1 8.7 17.5h34a2 2 0 0 1 1.9 2.6l-4.6 18.3a2.8 2.8 0 0 1-2.7 2.1H6.6A2 2 0 0 1 4.6 38Z" fill="url(#g-pasta)" stroke="#b88317"></path>
    <path d="M8 19.5h35.5" stroke="#fff6c8" stroke-width="1.2" opacity=".9"></path>
  </symbol>

  <symbol id="i-bloco" viewBox="0 0 48 48">
    <rect x="9" y="6.5" width="30" height="36" rx="2" fill="url(#g-papel)" stroke="#7f93b2"></rect>
    <rect x="9" y="6.5" width="30" height="7" rx="2" fill="url(#g-azul)" stroke="#1d4ea8"></rect>
    <g fill="none" stroke="#3b3b3b" stroke-width="1.4">
      <circle cx="14.5" cy="6.5" r="2"></circle><circle cx="20.5" cy="6.5" r="2"></circle><circle cx="26.5" cy="6.5" r="2"></circle><circle cx="32.5" cy="6.5" r="2"></circle>
    </g>
    <path d="M14 20h20M14 25h20M14 30h20M14 35h13" stroke="#9fb3d6" stroke-width="1.6"></path>
  </symbol>

  <symbol id="i-usuario" viewBox="0 0 48 48">
    <rect x="4" y="5" width="40" height="38" rx="5" fill="url(#g-papel)" stroke="#7f93b2"></rect>
    <circle cx="24" cy="19" r="7.5" fill="url(#g-azul)" stroke="#123f9c"></circle>
    <path d="M10.5 39c0-8 6-12.5 13.5-12.5S37.5 31 37.5 39Z" fill="url(#g-azul)" stroke="#123f9c"></path>
    <ellipse cx="22" cy="15.5" rx="4" ry="2.4" fill="#fff" opacity=".55"></ellipse>
  </symbol>

  <symbol id="i-correio" viewBox="0 0 48 48">
    <rect x="4.5" y="11" width="37" height="27" rx="3" fill="url(#g-papel)" stroke="#5f7396"></rect>
    <path d="M6 13l17 13 17-13" fill="none" stroke="#5f7396" stroke-width="1.8" stroke-linejoin="round"></path>
    <path d="M6 36.5l12-11M40 36.5l-12-11" stroke="#a7b6cf" stroke-width="1.4"></path>
    <circle cx="37" cy="35" r="8.5" fill="url(#g-azul)" stroke="#123f9c"></circle>
    <text x="37" y="39.2" text-anchor="middle" font-family="Tahoma, Verdana, sans-serif" font-size="12" font-weight="700" fill="#fff">@</text>
  </symbol>

  <symbol id="i-terminal" viewBox="0 0 48 48">
    <rect x="4.5" y="8" width="39" height="32" rx="3" fill="url(#g-escuro)" stroke="#000"></rect>
    <path d="M4.5 11a3 3 0 0 1 3-3h33a3 3 0 0 1 3 3v3h-39Z" fill="url(#g-azul)"></path>
    <path d="M10.5 21l5.5 4.5-5.5 4.5" fill="none" stroke="#e8e8e8" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M19.5 32h10" stroke="#e8e8e8" stroke-width="2.6" stroke-linecap="round"></path>
  </symbol>

  <symbol id="i-lixeira" viewBox="0 0 48 48">
    <path d="M11 13.5h26l-2.6 28.2a2.5 2.5 0 0 1-2.5 2.3H16.1a2.5 2.5 0 0 1-2.5-2.3Z" fill="url(#g-metal)" stroke="#55698a"></path>
    <path d="M16.5 17.5l1.3 23M24 17.5v23M31.5 17.5l-1.3 23" stroke="#7d8faa" stroke-width="1.2"></path>
    <path d="M13 22.5h22M13.6 29h20.8M14.2 35.5h19.6" stroke="#9eb0c8" stroke-width=".9"></path>
    <ellipse cx="24" cy="13.5" rx="14" ry="3.6" fill="#dfe8f4" stroke="#55698a"></ellipse>
    <ellipse cx="24" cy="13.5" rx="10.5" ry="2" fill="#7e90ac"></ellipse>
  </symbol>

  <symbol id="i-lixeira-cheia" viewBox="0 0 48 48">
    <use href="#i-lixeira"></use>
    <path d="M15 12.5l5-6.5 6 4-2 3.5Z" fill="#fff" stroke="#8a8a8a"></path>
    <path d="M25 12l7-5 3 6.5Z" fill="#f8f3d0" stroke="#b5a96a"></path>
  </symbol>

  <symbol id="i-paciencia" viewBox="0 0 48 48">
    <g transform="rotate(-14 20 26)">
      <rect x="7" y="9" width="24" height="33" rx="3" fill="url(#g-azul)" stroke="#123f9c"></rect>
      <rect x="10" y="12" width="18" height="27" rx="2" fill="none" stroke="#fff" stroke-opacity=".6"></rect>
    </g>
    <g transform="rotate(10 30 26)">
      <rect x="17" y="8" width="24" height="33" rx="3" fill="#fff" stroke="#55606e"></rect>
      <text x="20.5" y="17.5" font-size="8" font-weight="700" fill="#d01f2a" font-family="Georgia, serif">A</text>
      <path d="M29 22.5c-2.4-3.2-6.6-.8-4.7 2.5L29 31l4.7-6c1.9-3.3-2.3-5.7-4.7-2.5Z" fill="#d01f2a"></path>
    </g>
  </symbol>

  <symbol id="i-minas" viewBox="0 0 48 48">
    <rect x="4" y="4" width="40" height="40" rx="5" fill="#cfd3da" stroke="#7b818c"></rect>
    <path d="M4 9a5 5 0 0 1 5-5h30a5 5 0 0 1 5 5v3H4Z" fill="#fff" opacity=".5"></path>
    <path d="M24 10v28M10 24h28M14.1 14.1l19.8 19.8M33.9 14.1 14.1 33.9" stroke="#111" stroke-width="3" stroke-linecap="round"></path>
    <circle cx="24" cy="24" r="9.5" fill="#111"></circle>
    <circle cx="20.6" cy="20.6" r="2.8" fill="#fff"></circle>
  </symbol>

  <symbol id="i-sudoku" viewBox="0 0 48 48">
    <rect x="5" y="5" width="38" height="38" rx="4" fill="#fff" stroke="#2c4f8f" stroke-width="2"></rect>
    <path d="M17.7 6v36M30.3 6v36M6 17.7h36M6 30.3h36" stroke="#2c4f8f" stroke-width="1.6"></path>
    <rect x="18.5" y="18.5" width="11" height="11" fill="#cfe0fb"></rect>
    <g font-family="Tahoma, Verdana, sans-serif" font-size="9" font-weight="700" text-anchor="middle">
      <text x="11.9" y="15" fill="#111">5</text>
      <text x="36.1" y="15" fill="#111">3</text>
      <text x="24" y="27.3" fill="#1b4fc4">7</text>
      <text x="11.9" y="39.4" fill="#1b4fc4">9</text>
      <text x="36.1" y="39.4" fill="#111">1</text>
    </g>
  </symbol>

  <symbol id="i-documento" viewBox="0 0 48 48">
    <path d="M11 5h18l9 9v29H11Z" fill="url(#g-papel)" stroke="#7f93b2"></path>
    <path d="M29 5v9h9" fill="#d5deeb" stroke="#7f93b2" stroke-linejoin="round"></path>
    <rect x="15" y="22" width="19" height="13" rx="2" fill="url(#g-azul)"></rect>
    <text x="24.5" y="31.6" text-anchor="middle" font-family="Consolas, monospace" font-size="8.5" font-weight="700" fill="#fff">&lt;/&gt;</text>
  </symbol>

  <symbol id="i-busca" viewBox="0 0 48 48">
    <circle cx="20" cy="20" r="12" fill="#cfe6ff" fill-opacity=".55" stroke="#1d4ea8" stroke-width="3.2"></circle>
    <path d="M14 16a7 7 0 0 1 7-5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
    <path d="M29 29l11 11" stroke="#8a5a1c" stroke-width="6" stroke-linecap="round"></path>
  </symbol>

  <symbol id="i-info" viewBox="0 0 48 48">
    <circle cx="24" cy="24" r="20" fill="url(#g-azul)" stroke="#123f9c" stroke-width="1.5"></circle>
    <ellipse cx="24" cy="15" rx="13" ry="7" fill="url(#g-brilho)" opacity=".7"></ellipse>
    <circle cx="24" cy="14.5" r="3" fill="#fff"></circle>
    <path d="M20.5 20.5h5v14h3v3h-11v-3h3v-11h-3Z" fill="#fff"></path>
  </symbol>

  <symbol id="i-erro" viewBox="0 0 48 48">
    <circle cx="24" cy="24" r="20" fill="url(#g-vermelho)" stroke="#8c1a0c" stroke-width="1.5"></circle>
    <ellipse cx="24" cy="15" rx="13" ry="7" fill="url(#g-brilho)" opacity=".6"></ellipse>
    <path d="M16.5 16.5l15 15M31.5 16.5l-15 15" stroke="#fff" stroke-width="4.4" stroke-linecap="round"></path>
  </symbol>

  <symbol id="i-aviso" viewBox="0 0 48 48">
    <path d="M24 5 44.5 41h-41Z" fill="url(#g-amarelo)" stroke="#9a6b00" stroke-width="1.5" stroke-linejoin="round"></path>
    <path d="M24 17v12" stroke="#222" stroke-width="4.2" stroke-linecap="round"></path>
    <circle cx="24" cy="35" r="2.6" fill="#222"></circle>
  </symbol>

  <symbol id="i-cadeado" viewBox="0 0 48 48">
    <path d="M15 21v-5a9 9 0 0 1 18 0v5" fill="none" stroke="#7d8798" stroke-width="4"></path>
    <rect x="10" y="20" width="28" height="22" rx="4" fill="url(#g-amarelo)" stroke="#9a6b00"></rect>
    <circle cx="24" cy="29.5" r="3" fill="#6b4a00"></circle>
    <path d="M24 31v5" stroke="#6b4a00" stroke-width="2.6" stroke-linecap="round"></path>
  </symbol>

  <symbol id="i-desligar" viewBox="0 0 48 48">
    <rect x="3" y="3" width="42" height="42" rx="9" fill="url(#g-vermelho)" stroke="#8c1a0c"></rect>
    <path d="M5 13c0-5 3-8 8-8h22c5 0 8 3 8 8v3c-9 4-29 4-38 0Z" fill="url(#g-brilho)" opacity=".6"></path>
    <path d="M17 16.5a11 11 0 1 0 14 0" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round"></path>
    <path d="M24 11v13" stroke="#fff" stroke-width="3.6" stroke-linecap="round"></path>
  </symbol>

  <symbol id="i-reiniciar" viewBox="0 0 48 48">
    <rect x="3" y="3" width="42" height="42" rx="9" fill="url(#g-verde)" stroke="#145214"></rect>
    <path d="M5 13c0-5 3-8 8-8h22c5 0 8 3 8 8v3c-9 4-29 4-38 0Z" fill="url(#g-brilho)" opacity=".6"></path>
    <path d="M33.5 24a9.5 9.5 0 1 1-3.4-7.3" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round"></path>
    <path d="M27.5 12.5l4.5 4.3-5.2 3.4" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
  </symbol>

  <symbol id="i-logoff" viewBox="0 0 48 48">
    <rect x="3" y="3" width="42" height="42" rx="9" fill="url(#g-amarelo)" stroke="#9a6b00"></rect>
    <path d="M5 13c0-5 3-8 8-8h22c5 0 8 3 8 8v3c-9 4-29 4-38 0Z" fill="url(#g-brilho)" opacity=".6"></path>
    <path d="M21 13h-6v22h6" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M22 24h13M30 18.5l5.5 5.5-5.5 5.5" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
